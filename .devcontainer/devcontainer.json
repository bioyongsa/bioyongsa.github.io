{
  "name": "Jekyll Dev Container",
  "image": "mcr.microsoft.com/devcontainers/ruby:1-3.3-bullseye",
  
  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  
  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      "extensions": [
        "rebornix.Ruby",
        "shd101wyy.markdown-preview-enhanced",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  
  // Use 'postCreateCommand' to run commands after the container is created
  "postCreateCommand": "gem install bundler && bundle install && npm install",
  
  // Set environment variables
  "remoteEnv": {
    "BUNDLE_PATH": "/usr/local/bundle"
  },
  
  // Forward Jekyll's default port
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Server",
      "onAutoForward": "notify"
    }
  },
  
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root
  // "remoteUser": "root",
  
  // Use 'postStartCommand' to run commands each time the container starts
  "postStartCommand": "echo 'Dev container ready! Run: bundle exec jekyll serve --livereload'"
}
