{
  "name": "Jekyll Blog",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  
  "forwardPorts": [4000],
  
  "remoteUser": "root",
  
  "containerEnv": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  
  "waitFor": "onCreateCommand",
  "updateContentCommand": "",
  "postCreateCommand": "",
  
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  }
}
